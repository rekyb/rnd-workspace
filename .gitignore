# Local Claude Code config (machine-specific permissions)
.claude/settings.local.json

# Per-terminal active-research binding (machine-local, ephemeral)
.claude/.current-research/

# Raw / working research data (not committed)
raw-data/

# Litreview user-supplied source documents (copyright/size/PII — never committed)
research/*/corpus/

# Mobbin reference images (licensed third-party library content — never committed).
# Any depth, anywhere in the repo (research/, design/, nested platform folders).
# Directory-only pattern: the committed `references.md` mapping table is NOT matched.
**/reference/

# Generated visual reading copies (contain embedded reference images)
**/*.visual.md

# Word exports (may embed reference images; regenerate with md_to_docx.ps1).
# Both the conventional docx/ folder and the converter's default study-root path.
research/*/docx/
research/*/*.docx

# Subagent-driven-development scratch (ledger, briefs, reports, review packages)
.superpowers/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local isolated implementation worktrees
.worktrees/

# Generated single-file prototype build (~12 MB, rebuild with build-standalone.ps1)
design/onboarding-solve-edu/standalone.html

# Generated single-file prototype builds (rebuild with build-standalone.ps1)
design/*/build/
